# Template for env/development.env, the settings of the application on a developer's computer.
#
# The application never opens an env file by itself:
#   - On a developer's computer, scripts/local.mjs loads env/development.env before it starts a tool (npm run dev,
#     test:db, db:pull, db:dash:*, dash:refresh*, logs:find, seed, start:local). It also sets APP_ENV=development, so do
#     not write APP_ENV in this file.
#   - On a server (staging or production), systemd loads the environment file of the deployment. Create that file with
#     node scripts/ops/init-env.mjs and check it with node scripts/ops/env-check.mjs (docs/project-guide.md, chapter 10.8).
#
# How to use this template: make the folder env/ (git ignores it), copy this file to env/development.env and fill in the values.
# Rules for every environment file: one KEY=value per line, no spaces around the =, no "export", comments on their own
# line, no key twice, and only the keys below (a typo in a key is reported when the file is loaded).

# Database connection. Development: LOCAL database only (e.g. the `demo` database in XAMPP); the application refuses anything else.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/demo

# Maximum number of pooled connections (5-10)
DB_POOL_SIZE=5
# Max milliseconds one SELECT may run (0 = no limit)
DB_QUERY_TIMEOUT_MS=120000
# A query slower than this many ms is logged as a warning (SQL text only, no parameters). 0 = off
SLOW_QUERY_MS=1000
# Logging: one JSON object per line, written to standard output and to the daily file in LOG_DIR.
# Level: trace, debug, info, warn, error, fatal or silent. debug also logs the duration of every computed metric and every wait for a free connection.
LOG_LEVEL=info
# 1 = also write the daily file app.<yyyy-MM-dd>.<n>.log in LOG_DIR (a relative folder is relative to where the server is started)
LOG_TO_FILE=1
LOG_DIR=logs
# Daily log files older than this many days are removed
LOG_RETENTION_DAYS=30
# Name of this deployment (lowercase letters, digits, dashes). Written on every log line as "client", and fixed at BUILD time
# as the URL prefix /oxy-<CLIENT_ID>-finance-dashboard/ (npm run build:client -- <id>). The server must run with the same value
# the build used. The prefix comes only from CLIENT_ID in the environment of the build command (npm run build:client -- <id>),
# never from this file. Leave empty for local development at the root.
CLIENT_ID=
# A computed metric stays fresh for this many seconds (5-3600)
METRIC_FRESH_SECONDS=60
# After that the old answer is still shown for this many more seconds while it is recalculated in the background (0 = off)
METRIC_STALE_SECONDS=180
# Session cookie encryption secret, at least 32 random characters
SESSION_SECRET=replace-with-at-least-32-random-characters

# Time zone used to decide "today" (see plans/README.md section 9, K5)
APP_TIMEZONE=Asia/Jakarta

# Cash Position flags funds in settlement older than this many days (default 3). Raise it when the client releases settlements late.
IN_TRANSIT_ALERT_DAYS=3

# ERP APP_ID_INDEX used to generate a new system_main row ID (plan phase 8, step 8.5)
ERP_APP_ID_INDEX=7

# Integration tests & seed only (development only: refused in a staging or production file). Must be a local host.
# Fixed "today" for integration tests (defaults to 2025-10-15, inside the demo data window).
TEST_TODAY=2025-10-15
# Optional fixed "today" for the app itself (ERP reconciliation on historical data). Allowed in development and staging,
# refused by the application in production.
APP_TODAY=
TEST_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/finance_dashboard_dev
SEED_DEMO_LOGIN_ID=demo
SEED_DEMO_PASSWORD=change-me-demo-password

# Server started with npm run start:local (or npm start on a server). Port and bind address.
PORT=3000
HOST=0.0.0.0
# Set to 1 only when a reverse proxy in front of the app sets X-Forwarded-For.
TRUST_PROXY=0

# Snapshot tables (dash_*): background refresh of the heavy AP/AR numbers
DASH_REFRESH_ENABLED=1
DASH_REFRESH_MINUTES=10
# Completed month-ends of AP/AR history kept in dash_snap_ap_ar_hist_* (0 = off). Makes "Last month" and the comparison figures fast.
DASH_AP_AR_HIST_MONTHS=13
# Extra connections used only by the background snapshot refresh (1-5). The server then opens DB_POOL_SIZE + DASH_POOL_SIZE connections.
DASH_POOL_SIZE=2
# 1 = apply pending dash_* migrations at server start (otherwise run `npm run db:dash:migrate`)
AUTO_MIGRATE=0
# Folder with the dash_* migration files (default: ./drizzle-dash next to where the server is started)
# DASH_MIGRATIONS_DIR=
