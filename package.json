{
  "name": "oxy-finance-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node scripts/start-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "db:pull": "drizzle-kit pull",
    "db:dash:generate": "drizzle-kit generate --config drizzle.dash.config.ts",
    "db:dash:check": "drizzle-kit check --config drizzle.dash.config.ts",
    "db:dash:migrate": "tsx scripts/dash-migrate.ts",
    "db:dash:status": "tsx scripts/dash-migrate.ts --status",
    "dash:refresh": "tsx scripts/dash-refresh.ts",
    "dash:refresh-gl": "tsx scripts/dash-refresh-gl.ts",
    "dash:refresh-hist": "tsx scripts/dash-refresh-hist.ts",
    "seed": "tsx scripts/seed/index.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "i18next": "26.5.11",
    "iron-session": "9.0.1",
    "lucide-react": "1.63.0",
    "mysql2": "3.24.6",
    "papaparse": "5.7.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
